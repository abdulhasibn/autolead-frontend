{
  "protectedBranches": ["main", "dev"],
  "branchPattern": "^(feat|fix|chore|docs|refactor|test|perf|ci|hotfix|claude)/[a-z0-9][a-z0-9._/-]*$",
  "prodProjectRefs": [],
  "guardPaths": [
    "scripts/guard/",
    ".claude/settings.json",
    ".husky/pre-commit",
    ".husky/pre-merge-commit",
    ".husky/pre-push",
    ".github/workflows/branch-guard.yml"
  ]
}
