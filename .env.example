# Authentication — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here-min-32-chars-replace-this

# API — backend base URL
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional — showroom used when creating leads for accounts without a home
# showroom (e.g. admins). Accounts with a home showroom always use their own.
DEFAULT_SHOWROOM_ID=b0000000-0000-4000-8000-000000000001

# App URL (used by Auth.js for redirects)
AUTH_URL=http://localhost:3001
